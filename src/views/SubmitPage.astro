---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../../site.config.mjs';
import { categories, categoryName } from '../lib/data';
import { localizedPath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const it = lang === 'it';
const issueBase = `https://github.com/${siteConfig.githubRepo}/issues/new`;
const templateUrl = `${issueBase}?template=nuovo-strumento.yml`;

const copy = it
  ? {
      lead: 'Conosci uno strumento gratuito o open source utile a chi progetta? Compila i campi: si aprirà una proposta precompilata su GitHub, dove potrai controllarla e inviarla.',
      name: 'Nome dello strumento',
      url: 'Indirizzo del sito (URL)',
      category: 'Categoria',
      license: 'Licenza',
      description: 'Descrizione breve',
      descriptionHint: 'Una o due frasi: che cosa fa e perché è utile.',
      notes: 'Note (facoltative)',
      notesHint: 'Es. limiti del piano gratuito, formati esportati, copertura geografica.',
      choose: 'Scegli…',
      unsure: 'Non so',
      submit: 'Apri la proposta su GitHub',
      account: 'Serve un account GitHub gratuito. Non hai un account? Puoi anche aprire direttamente il modulo vuoto:',
      template: 'modulo di proposta',
      criteria: 'Prima di proporre, controlla i criteri di inclusione nella pagina',
      required: 'obbligatorio',
    }
  : {
      lead: 'Know a free or open-source tool that helps designers? Fill in the fields: a pre-filled suggestion will open on GitHub, where you can review and submit it.',
      name: 'Tool name',
      url: 'Website address (URL)',
      category: 'Category',
      license: 'Licence',
      description: 'Short description',
      descriptionHint: 'One or two sentences: what it does and why it is useful.',
      notes: 'Notes (optional)',
      notesHint: 'E.g. free plan limits, export formats, geographic coverage.',
      choose: 'Choose…',
      unsure: 'Not sure',
      submit: 'Open the suggestion on GitHub',
      account: 'A free GitHub account is required. You can also open the empty form directly:',
      template: 'suggestion form',
      criteria: 'Before suggesting, check the inclusion criteria on the page',
      required: 'required',
    };
---

<Base lang={lang} title={t('submit.title')} altPath={localizedPath(it ? 'en' : 'it', 'submit')}>
  <div class="wrap pt-10 md:pt-14">
    <header class="mb-10 max-w-3xl">
      <p class="eyebrow">{t('nav.submit')}</p>
      <h1 class="mt-3 text-3xl font-semibold md:text-4xl">{t('submit.title')}</h1>
      <p class="mt-3 text-muted">{copy.lead}</p>
      <p class="mt-3 text-sm text-muted">
        {copy.criteria} <a class="text-accent underline" href={localizedPath(lang, 'about')}>{t('nav.about')}</a>.
      </p>
    </header>

    <form class="max-w-2xl space-y-6" data-submit-form data-issue-base={issueBase} data-lang={lang}>
      <div>
        <label for="s-name" class="mb-1.5 block text-sm font-medium">{copy.name} <span class="meta">({copy.required})</span></label>
        <input id="s-name" name="name" class="field" required maxlength="80" autocomplete="off" />
      </div>
      <div>
        <label for="s-url" class="mb-1.5 block text-sm font-medium">{copy.url} <span class="meta">({copy.required})</span></label>
        <input id="s-url" name="url" type="url" class="field" required placeholder="https://" autocomplete="off" />
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="s-cat" class="mb-1.5 block text-sm font-medium">{copy.category}</label>
          <select id="s-cat" name="category" class="field">
            <option value="">{copy.choose}</option>
            {categories.map((c) => <option value={c.id}>{categoryName(c, lang)}</option>)}
          </select>
        </div>
        <div>
          <label for="s-lic" class="mb-1.5 block text-sm font-medium">{copy.license}</label>
          <select id="s-lic" name="license" class="field">
            <option value="">{copy.unsure}</option>
            <option value="open-source">{t('license.open-source')}</option>
            <option value="gratuito">{t('license.gratuito')}</option>
            <option value="freemium">{t('license.freemium')}</option>
          </select>
        </div>
      </div>
      <div>
        <label for="s-desc" class="mb-1.5 block text-sm font-medium">{copy.description}</label>
        <textarea id="s-desc" name="description" class="field min-h-24" maxlength="300" aria-describedby="s-desc-hint"></textarea>
        <p id="s-desc-hint" class="mt-1 text-xs text-muted">{copy.descriptionHint}</p>
      </div>
      <div>
        <label for="s-notes" class="mb-1.5 block text-sm font-medium">{copy.notes}</label>
        <textarea id="s-notes" name="notes" class="field min-h-20" maxlength="600" aria-describedby="s-notes-hint"></textarea>
        <p id="s-notes-hint" class="mt-1 text-xs text-muted">{copy.notesHint}</p>
      </div>
      <button type="submit" class="btn btn-primary">
        {copy.submit}
        <Icon name="arrow-up-right" size={16} />
      </button>
      <p class="text-sm text-muted">
        {copy.account} <a class="text-accent underline" href={templateUrl} target="_blank" rel="noopener">{copy.template}</a>.
      </p>
    </form>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-submit-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const params = new URLSearchParams({ template: 'nuovo-strumento.yml', title: `[Nuovo strumento] ${name}` });
    for (const key of ['name', 'url', 'category', 'license', 'description', 'notes']) {
      const v = String(data.get(key) ?? '').trim();
      if (v) params.set(key, v);
    }
    window.open(`${form.dataset.issueBase}?${params}`, '_blank', 'noopener');
  });
</script>
