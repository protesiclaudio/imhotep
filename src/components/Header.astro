---
import Icon from './Icon.astro';
import { localizedPath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altPath: string;
}
const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
const current = Astro.url.pathname;

const links = [
  { href: localizedPath(lang, 'tools'), label: t('nav.tools') },
  { href: localizedPath(lang, 'home') + '#categorie', label: t('nav.categories') },
  { href: localizedPath(lang, 'favorites'), label: t('nav.favorites'), fav: true },
  { href: localizedPath(lang, 'submit'), label: t('nav.submit') },
  { href: localizedPath(lang, 'about'), label: t('nav.about') },
  { href: localizedPath(lang, 'imhotep'), label: t('nav.imhotep') },
];
const isCurrent = (href: string) => !href.includes('#') && current.startsWith(href) && href !== localizedPath(lang, 'home');
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/95 backdrop-blur-sm">
  <div class="wrap flex h-16 items-center gap-4">
    <a href={localizedPath(lang, 'home')} class="flex items-center gap-2.5 no-underline" aria-label={t('site.name')}>
      {/* Logo: piramide a gradoni di Djoser e sole */}
      <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M2 28V23H6V18H10V13H22V18H26V23H30V28Z" fill="none" stroke="currentColor" stroke-width="2"></path>
        <path d="M1 28H31" stroke="currentColor" stroke-width="2"></path>
        <circle cx="25" cy="6.5" r="3.2" fill="var(--accent)"></circle>
      </svg>
      <span class="text-[0.9375rem] font-semibold tracking-tight">{t('site.name')}</span>
    </a>

    <nav aria-label={t('nav.main')} class="ml-auto">
      <button
        type="button"
        class="icon-btn md:hidden"
        aria-expanded="false"
        aria-controls="nav-list"
        data-nav-toggle
      >
        <span class="sr-only">{t('nav.menu')}</span>
        <Icon name="menu" />
      </button>
      <ul
        id="nav-list"
        class="nav-list hidden md:flex md:items-center md:gap-1"
        data-nav-list
      >
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="nav-link"
                aria-current={isCurrent(l.href) ? 'page' : undefined}
              >
                {l.label}
                {l.fav && <span class="fav-count meta" data-fav-count hidden />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a href={altPath} class="btn btn-ghost px-2.5 font-mono text-xs" hreflang={lang === 'it' ? 'en' : 'it'} lang={lang === 'it' ? 'en' : 'it'}>
        <span aria-hidden="true">{t('lang.short')}</span>
        <span class="sr-only">{t('lang.switch')}</span>
      </a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label={t('theme.toggle')} data-label-dark={t('theme.dark')} data-label-light={t('theme.light')}>
        <span class="theme-icon-dark"><Icon name="moon" /></span>
        <span class="theme-icon-light"><Icon name="sun" /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--muted);
    border-radius: 2px;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--ink);
  }
  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  .fav-count {
    min-width: 1.25rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--ink);
    text-align: center;
  }
  .theme-icon-light {
    display: none;
  }
  :global([data-theme='dark']) .theme-icon-light {
    display: inline;
  }
  :global([data-theme='dark']) .theme-icon-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-icon-light {
      display: inline;
    }
    :global(:root:not([data-theme='light'])) .theme-icon-dark {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .nav-list.is-open {
      display: flex;
      flex-direction: column;
      position: absolute;
      left: 0;
      right: 0;
      top: 4rem;
      padding: 0.5rem 1rem 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .nav-list.is-open .nav-link {
      width: 100%;
      padding: 0.75rem 0;
      font-size: 1rem;
      color: var(--ink);
    }
  }
</style>

<script>
  import { getFavorites, onFavoritesChange } from '../scripts/favorites';

  // Menu mobile
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const list = document.querySelector<HTMLElement>('[data-nav-list]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    list?.classList.toggle('is-open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.setAttribute('aria-expanded', 'false');
      list?.classList.remove('is-open');
      toggle.focus();
    }
  });

  // Tema: segue il sistema finché l'utente non sceglie a mano.
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const isDark = () =>
    document.documentElement.dataset.theme
      ? document.documentElement.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
  const syncThemeLabel = () => {
    if (!themeBtn) return;
    themeBtn.setAttribute('aria-label', (isDark() ? themeBtn.dataset.labelLight : themeBtn.dataset.labelDark) ?? '');
  };
  syncThemeLabel();
  themeBtn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('atlante:theme', next);
    } catch {}
    syncThemeLabel();
  });

  // Contatore dei preferiti nella navigazione
  const renderCount = () => {
    const n = getFavorites().size;
    document.querySelectorAll<HTMLElement>('[data-fav-count]').forEach((el) => {
      el.textContent = String(n);
      el.hidden = n === 0;
    });
  };
  renderCount();
  onFavoritesChange(renderCount);
</script>
